APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL 只在 Compose backend 网络中可见，不发布端口。
POSTGRES_DB=imap_mail
POSTGRES_USER=imap_mail_runtime
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_32_CHAR_PASSWORD
DATABASE_URL=postgresql+asyncpg://imap_mail_runtime:REPLACE_WITH_A_RANDOM_32_CHAR_PASSWORD@postgres:5432/imap_mail
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_CONNECT_TIMEOUT_SECONDS=5

ADMIN_SESSION_COOKIE=admin_session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=strict
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900

DOCS_USERNAME=docs
DOCS_PASSWORD=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_PASSWORD
EXTERNAL_API_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_API_KEY
MAILBOX_CREDENTIALS_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# 使用浏览器访问的 HTTPS 前端来源；不要填 *。
CORS_ORIGINS=["https://mail.example.com"]
CORS_ALLOW_CREDENTIALS=true

IMAP_ALLOWED_HOSTS=["imap.gmail.com"]
PROXY_ALLOWED_HOSTS=[]
IMAP_DEFAULT_HOST=imap.gmail.com
IMAP_DEFAULT_PORT=993
IMAP_CONNECT_TIMEOUT_SECONDS=15
IMAP_IDLE_TIMEOUT_SECONDS=1740
IMAP_RECONNECT_MAX_SECONDS=300
PROXY_CHECK_TIMEOUT_SECONDS=5
PROXY_BACKOFF_BASE_SECONDS=2
PROXY_BACKOFF_MAX_SECONDS=300

MESSAGE_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=3600
MAX_PAGE_SIZE=100
MAX_QUERY_LENGTH=200
MESSAGE_BODY_MAX_CHARS=1000000

# 复制为 .env 后按部署环境填写；不要提交真实密钥。
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
PUBLIC_BASE_URL=https://YOUR_DOMAIN
CORS_ORIGINS=https://FRONTEND_DOMAIN
API_BASE_URL=https://API_DOMAIN
CORS_ALLOW_CREDENTIALS=true

# 唯一持久化数据库
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_SSL_MODE=require
DATABASE_SSL_CA=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 管理员登录；服务启动时会创建或同步该账号。生产环境请通过 Secret Manager 注入密码。
ADMIN_SESSION_COOKIE=admin_session
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_LOCAL_PASSWORD
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10

# FastAPI 文档 Basic Auth
DOCS_USERNAME=docs
DOCS_PASSWORD=CHANGE_ME_TO_A_LONG_DOCS_PASSWORD

# 外部接口 API Key
EXTERNAL_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_API_KEY

# IMAP IDLE
IMAP_DEFAULT_HOST=imap.gmail.com
IMAP_DEFAULT_PORT=993
IMAP_TLS_VERIFY=true
IMAP_IDLE_TIMEOUT_SECONDS=1740
IMAP_RECONNECT_BASE_SECONDS=2
IMAP_RECONNECT_MAX_SECONDS=300
IMAP_FETCH_BATCH_SIZE=100
IMAP_NOOP_INTERVAL_SECONDS=300
IMAP_WORKER_HEARTBEAT_SECONDS=30
IMAP_BASELINE_MODE=baseline
IMAP_PROXY_DEFAULT_MODE=direct
IMAP_PROXY_CHECK_TIMEOUT_SECONDS=5
IMAP_PROXY_RECONNECT_BASE_SECONDS=2
IMAP_PROXY_RECONNECT_MAX_SECONDS=300
IMAP_PROXY_JITTER_RATIO=0.2

# 邮件与验证码保留
MESSAGE_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=500
VERIFICATION_CODE_LOOKBACK_DAYS=30
SEARCH_MAX_PAGE_SIZE=100
MESSAGE_BODY_MAX_CHARS=1000000
MAX_QUERY_LENGTH=200
IMAP_ALLOWED_HOSTS=imap.gmail.com

# 仅保存 Secret 引用；App Password 由 Secret Manager 或环境变量注入
MAILBOX_APP_PASSWORD_SECRET_REF=SECRET_REF

# 每邮箱配置字段（写入 PostgreSQL 的配置记录；以下仅为字段说明）
# proxy_mode=direct|socks5
# proxy_host=PROXY_HOST
# proxy_port=1080
# proxy_username=PROXY_USERNAME
# proxy_password_secret_ref=SECRET_REF
# proxy_dns_mode=remote|local

# 健康检查
HEALTH_CHECK_TIMEOUT_SECONDS=2

